rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contacts collection: all writes go through the submitVolunteer
    // Cloud Function (Admin SDK, bypasses rules). No client access needed.
    match /contacts/{contactId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
